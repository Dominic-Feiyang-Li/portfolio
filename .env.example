# SQLite is the default for local use. For Vercel, use your own Supabase project.
# PORTFOLIO_STORAGE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PORTFOLIO_ORIGIN=https://your-app.example.com

# Require login locally if desired. Cloud mode always requires login.
# PORTFOLIO_AUTH_ENABLED=1
# PORTFOLIO_SESSION_SECRET=
# PORTFOLIO_DATA_DIR=

# Optional AI and scheduled valuations. Keep credentials server-side.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# CRON_SECRET=
